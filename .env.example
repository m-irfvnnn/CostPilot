# ============================================
# Pre-CRM Engine — Environment Variables
# ============================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. All values here are placeholders.
# Use strictly synthetic test payloads (e.g., alex@ai-labs.io) in dev.

# ---------- App ----------
NODE_ENV=development
PORT=5678

# ---------- Supabase (PostgreSQL) ----------
# Project URL & anon key from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---------- n8n ----------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=your-n8n-encryption-key
N8N_USER_MANAGEMENT_JWT_SECRET=your-n8n-jwt-secret

# ---------- Hookdeck ----------
# Hookdeck CLI / API for reliable webhook delivery
HOOKDECK_API_KEY=your-hookdeck-api-key
HOOKDECK_SIGNING_SECRET=your-hookdeck-signing-secret
HOOKDECK_SOURCE_URL=https://events.hookdeck.com/e/your-source-id

# ---------- DeepSeek API (orchestration) ----------
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LITELLM_MASTER_KEY=
COSTPILOT_USAGE_INGEST_KEY=
COSTPILOT_USAGE_INGEST_URL=http://host.docker.internal:3000/api/product/usage/ingest
COSTPILOT_PRODUCT_TEST_ACCOUNT_ID=
COSTPILOT_PRODUCT_TEST_WORKSPACE_ID=
COSTPILOT_PRODUCT_TEST_ACCOUNT_SLUG=

# ---------- Gemini API (AI Scoring & Intelligence) ----------
# Used by the AI Scoring Engine to analyze firmographics and
# return icp_score, buying_intent, and personalized_icebreaker.
GEMINI_API_KEY=your-gemini-api-key
# gemini-3.5-flash-lite: high free quota, strict-JSON capable (scoring + email
# writing verified). Google retired the 2.x generation for new users, so use a
# current-gen model. Switch by editing this line + `docker compose up -d`, no
# workflow changes needed.
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent


# ---------- HubSpot CRM ----------
# CRM Gatekeeper: only send leads to HubSpot when icp_score >= 70
# AND email verified as deliverable.
HUBSPOT_API_KEY=your-hubspot-api-key
# Private app access token (Settings -> Integrations -> Private Apps).
# Free CRM plan supports private apps; scopes needed: crm.objects.deals.read/write,
# crm.objects.contacts.read/write. Token shown ONCE at creation — copy it then.
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token
HUBSPOT_BASE_URL=https://api.hubapi.com

# ---------- Slack Alerts (Module 4) ----------
# Incoming webhook URL (api.slack.com/apps -> Incoming Webhooks -> Add New
# Webhook to Workspace). Free Slack plan includes incoming webhooks.
# Module 4 posts qualified-lead alerts here; also used for nurture notices.
SLACK_WEBHOOK_URL=your-slack-incoming-webhook-url

# ---------- Nurture Emails (Module 4 follow-up) ----------
# Brevo transactional email (free tier: 300 emails/day, no credit card,
# personal email OK as sender). Set BREVO_API_KEY to ACTIVATE nurture emails
# (then recreate the n8n container). Leave empty to keep nurture = Slack only.
# Steps: sign up -> Settings/keys/api -> generate API key; Settings/senders ->
# add + VERIFY your sender email (unverified senders are rejected).
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_NAME=Pre-CRM Engine
BREVO_SENDER_EMAIL=your-verified-sender@example.com

# ---------- Email Verification ----------
# Stage 2 gate. Set EMAIL_VERIFY_API_KEY to ACTIVATE verification (then
# recreate the n8n container). Leave empty to keep the gate off.
# Provider pick via base URL (all free, no business email needed; the n8n
# node appends ?api_key=...&email=... itself — keep params out of BASE_URL):
#   Emailable:   EMAIL_VERIFY_BASE_URL=https://api.emailable.com/v1/verify   (250 free credits, recommended)
#   Abstract:    EMAIL_VERIFY_BASE_URL=https://emailvalidation.abstractapi.com/v1/
#   Hunter:      EMAIL_VERIFY_BASE_URL=https://api.hunter.io/v2/email-verifier
#   ZeroBounce:  EMAIL_VERIFY_BASE_URL=https://api.zerobounce.net/v2/validate
EMAIL_VERIFY_API_KEY=
EMAIL_VERIFY_BASE_URL=https://api.emailable.com/v1/verify

# ---------- Cloudflare Turnstile (M0.5 anti-bot gate) ----------
# Server-side verification of form submissions. Widget lives on the website
# form (client-side); the engine verifies the token via siteverify here.
# Empty TURNSTILE_SECRET_KEY = gate OFF (v1 gate pattern).
# Real keys come from dash.cloudflare.com -> Turnstile -> Add site.
# NOTE: Cloudflare's documented TEST keys (1x...AA / 2x...AB) validate the
# widget only — siteverify returns invalid-input-secret (HTTP 400) for server
# calls. Use real keys from your Cloudflare dashboard for verification.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Outbound ingest (v2) ----------
# The v2 outbound webhook path on the local n8n instance. The scraper output
# (scripts/demo_outbound.cjs) posts here with source_type='outbound_scraped'.
OUTBOUND_WEBHOOK_PATH=/webhook/outbound

# ---------- MX sidecar (v2 outbound gate) ----------
# n8n's Code-node sandbox can't use Node dns, so a tiny HTTP service does the
# MX lookup. It now runs as the `mx-service` docker service (revops_mx,
# auto-starts with docker compose up -d; reachable at http://mx-service:9001).
# Port 9001 is mapped to the host for curl/debug. Standalone (no Docker):
# npm run mx:start.
MX_SERVICE_PORT=9001

# ---------- Scraper (v2 outbound front door, M1/M2) ----------
# Polite-crawl defaults. SCRAPER_DELAY_MS is the minimum delay between page
# fetches per domain; SCRAPER_MAX_PAGES_PER_DOMAIN caps crawl breadth. A custom
# user agent is good hygiene. SCRAPER_FORCE_RENDER=1 forces the Playwright
# fallback for testing JS-only pages. All have sensible defaults if unset.
SCRAPER_USER_AGENT=PreCRM-Engine/1.0 (polite demo crawler; contact: you@example.com)
SCRAPER_DELAY_MS=2000
SCRAPER_MAX_PAGES_PER_DOMAIN=10
SCRAPER_FORCE_RENDER=0


# ---------- Enrichment (Stage 4) ----------
# Apollo organization enrichment (free Starter plan). Set ENRICH_API_KEY to
# ACTIVATE (then recreate the n8n container). Leave empty to keep the gate
# off — leads then score on form-provided firmographics only.
# NOTE: Apollo requires the key in the X-Api-Key HEADER (not the body).
ENRICH_API_KEY=
ENRICH_BASE_URL=https://api.apollo.io/v1/organizations/enrich
