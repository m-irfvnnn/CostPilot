# CostPilot Web App environment template
# Safe for public repos. Keep real values in `.env.local` or Vercel project envs.

# Firebase web client config
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Server-side integrations
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id"}
COSTPILOT_USAGE_INGEST_KEY=your-server-to-server-usage-ingest-key
COSTPILOT_PRODUCT_PQL_TEST_URL=http://localhost:5678/webhook/costpilot-product-pql-test

# Server-side website signup -> Pre-CRM ingestion.
# Local manual n8n test mode:
# COSTPILOT_PRECRM_INGEST_URL=http://localhost:5678/webhook-test/hookdeck-lead-ingest
COSTPILOT_PRECRM_INGEST_URL=

# Billing: TEST mode only for this portfolio demo
PAYU_MERCHANT_KEY=your-payu-test-merchant-key
PAYU_SALT=your-payu-test-salt
PAYU_ENV=test
PAYU_BASE_URL=https://test.payu.in
